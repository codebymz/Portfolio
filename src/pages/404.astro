---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found | Muhammad Zain Ul Abdin"
  description="The page you requested could not be found."
  canonical="https://mzainulabdin.xyz/404"
>
  <main class="site-container not-found-container" id="main-content">
    <div class="not-found-content">
      <span class="not-found-code">404</span>
      <h1 class="not-found-title">Page not found</h1>
      <p class="not-found-text">
        The page you are looking for does not exist or has been moved.
      </p>
      <div class="not-found-actions">
        <a href="/" class="btn btn-primary">
          <span>Return to home</span>
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .not-found-container {
    min-height: calc(100vh - 200px);
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding-top: clamp(100px, 15vw, 160px);
    padding-bottom: clamp(64px, 10vw, 120px);
  }

  .not-found-content {
    max-width: var(--text-column-max-w);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .not-found-code {
    font-size: var(--font-size-small);
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: var(--space-8);
  }

  .not-found-title {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 700;
    line-height: var(--line-height-display);
    letter-spacing: var(--letter-spacing-display);
    color: var(--text);
    margin: 0 0 var(--space-12) 0;
  }

  .not-found-text {
    font-size: var(--font-size-body);
    font-weight: 400;
    line-height: var(--line-height-body);
    color: var(--text-muted);
    margin: 0 0 var(--space-24) 0;
  }

  .not-found-actions {
    display: flex;
    align-items: center;
  }
</style>
