---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { featuredProjects, type FeaturedProject } from '../../data/projects';

export function getStaticPaths() {
  return featuredProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: FeaturedProject;
}

const { project } = Astro.props;

const pageTitle = `${project.title} | Muhammad Zain Ul Abdin`;
const pageDescription = project.summary;
const pageCanonical = `https://mzainulabdin.xyz/projects/${project.slug}`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
>
  <div class="site-container project-detail-container">
    <!-- Back to Work Navigation -->
    <nav class="back-nav" aria-label="Back navigation">
      <a href="/#work" class="link-accent back-link">
        ← Back to Work
      </a>
    </nav>

    <!-- Project Header -->
    <header class="project-header">
      <h1 class="project-title">{project.title}</h1>
      <p class="project-summary">{project.summary}</p>
    </header>

    <!-- Media Area (Video, Screenshot or Placeholder) -->
    <section class="project-media" aria-label="Project media">
      {project.videoUrl ? (
        <div class="video-container" style="border-radius: var(--radius-media); overflow: hidden; border: 1px solid var(--border); background: #000;">
          <video
            src={project.videoUrl}
            autoplay
            loop
            muted
            playsinline
            controls
            style="width: 100%; height: auto; display: block;"
          ></video>
        </div>
      ) : project.screenshot && project.screenshot !== 'TODO' ? (
        <div class="project-media-wrapper media-animated">
          <img
            src={project.screenshot}
            alt={`${project.title} screenshot`}
            class="project-detail-img"
          />
          <div class="media-sheen" aria-hidden="true"></div>
        </div>
      ) : (
        <div class="screenshot-placeholder" aria-label={`${project.title} screenshot placeholder`}>
          <span class="placeholder-title">{project.title}</span>
          <span class="placeholder-label">Preview media (Video or Screenshot)</span>
        </div>
      )}
    </section>

    <!-- What it does Section -->
    <section class="detail-section" aria-label="What it does">
      <h2 class="detail-heading">What it does</h2>
      <ul class="feature-list" role="list">
        {project.whatItDoes.map((item) => (
          <li class="feature-item">{item}</li>
        ))}
      </ul>
    </section>

    <!-- Technologies Section -->
    <section class="detail-section" aria-label="Technologies used">
      <h2 class="detail-heading">Technologies</h2>
      <div class="tag-group">
        {Array.isArray(project.stack) ? (
          project.stack.map((tech) => <span class="tag">{tech}</span>)
        ) : (
          <span class="tag tag-todo">Stack: TODO</span>
        )}
      </div>
    </section>

    <!-- Project Links -->
    <section class="detail-section links-section" aria-label="Project links">
      <h2 class="detail-heading">Links</h2>
      <div class="action-links">
        {project.liveUrl && (
          <a
            href={project.liveUrl}
            class="link-accent"
            target="_blank"
            rel="noopener noreferrer"
          >
            Open live site
          </a>
        )}
        {project.isComingSoon && (
          <span class="status-label">Coming soon</span>
        )}

        {project.githubUrl && (
          <a
            href={project.githubUrl}
            class="link-accent"
            target="_blank"
            rel="noopener noreferrer"
          >
            View on GitHub
          </a>
        )}
        {project.isPrivateRepo && (
          <span class="status-label">Private repository</span>
        )}
      </div>
    </section>

    <!-- Bottom Back Link -->
    <div class="bottom-nav">
      <a href="/#work" class="link-accent back-link">
        ← Back to Work
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .project-detail-container {
    max-width: var(--container-max-w);
    padding-top: var(--space-48);
    padding-bottom: var(--space-96);
  }

  .back-nav {
    margin-bottom: var(--space-32);
  }

  .back-link {
    font-size: var(--font-size-small);
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .project-header {
    margin-bottom: var(--space-48);
    max-width: var(--text-column-max-w);
  }

  .project-title {
    font-size: var(--font-size-display);
    font-weight: 700;
    line-height: var(--line-height-display);
    letter-spacing: var(--letter-spacing-display);
    color: var(--text);
    margin: 0 0 var(--space-16) 0;
  }

  .project-summary {
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    color: var(--text-muted);
    margin: 0;
    max-width: 65ch;
  }

  /* Screenshot */
  .project-media {
    margin-bottom: var(--space-64);
  }

  .project-media-wrapper {
    position: relative;
    width: 100%;
    border-radius: var(--radius-media);
    border: 1px solid var(--border);
    overflow: hidden;
    background-color: var(--surface);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease;
  }

  .project-media-wrapper.media-animated {
    animation: media-float 7s ease-in-out infinite;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.08), 0 0 25px -5px rgba(0, 102, 214, 0.12);
  }

  :root[data-theme="dark"] .project-media-wrapper.media-animated {
    box-shadow: 0 14px 40px -10px rgba(0, 0, 0, 0.5), 0 0 30px -4px rgba(10, 132, 255, 0.22);
  }

  .project-media-wrapper:hover {
    transform: translateY(-6px) scale(1.01);
    border-color: rgba(0, 102, 214, 0.4);
    box-shadow: 0 20px 45px -10px rgba(0, 102, 214, 0.22), 0 0 30px -2px rgba(0, 180, 255, 0.25);
  }

  :root[data-theme="dark"] .project-media-wrapper:hover {
    border-color: rgba(10, 132, 255, 0.6);
    box-shadow: 0 24px 50px -10px rgba(0, 0, 0, 0.7), 0 0 35px 2px rgba(10, 132, 255, 0.4);
  }

  .project-detail-img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-media-wrapper:hover .project-detail-img {
    transform: scale(1.03);
  }

  .media-sheen {
    position: absolute;
    top: 0;
    left: -120%;
    width: 60%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.24),
      transparent
    );
    transform: skewX(-20deg);
    pointer-events: none;
    transition: left 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :root[data-theme="dark"] .media-sheen {
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.16),
      transparent
    );
  }

  .project-media-wrapper:hover .media-sheen {
    left: 150%;
  }

  @keyframes media-float {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-media-wrapper.media-animated {
      animation: none;
    }
    .project-media-wrapper,
    .project-detail-img,
    .media-sheen {
      transition: none;
      transform: none !important;
    }
  }

  .screenshot-placeholder {
    width: 100%;
    aspect-ratio: 16 / 10;
    min-height: 280px;
    border: 1px solid var(--border);
    border-radius: var(--radius-media);
    background-color: var(--surface);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-8);
    padding: var(--space-32);
    text-align: center;
  }

  .placeholder-title {
    font-size: var(--font-size-body);
    font-weight: 600;
    color: var(--text);
  }

  .placeholder-label {
    font-size: var(--font-size-small);
    color: var(--text-muted);
  }

  /* Detail Sections */
  .detail-section {
    margin-bottom: var(--space-48);
    max-width: var(--text-column-max-w);
  }

  .detail-heading {
    font-size: var(--font-size-h3);
    font-weight: 600;
    color: var(--text);
    margin-bottom: var(--space-16);
  }

  .feature-list {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .feature-item {
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    color: var(--text);
    max-width: 65ch;
  }

  .tag-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  .tag-todo {
    border-style: dashed;
    color: var(--text-muted);
  }

  .action-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-24);
  }

  .status-label {
    font-size: var(--font-size-small);
    color: var(--text-muted);
    font-weight: 500;
  }

  .bottom-nav {
    margin-top: var(--space-64);
    padding-top: var(--space-32);
    border-top: 1px solid var(--border);
  }
</style>
