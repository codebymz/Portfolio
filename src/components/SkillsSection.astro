---
interface SkillItem {
  name: string;
}

interface SkillDomain {
  id: string;
  category: string;
  label: string;
  badge: string;
  skills: SkillItem[];
}

const skillDomains: SkillDomain[] = [
  {
    id: "frontend",
    category: "frontend",
    label: "Frontend",
    badge: "UI & Client",
    skills: [
      { name: "React" },
      { name: "Next.js" },
      { name: "TypeScript" },
      { name: "JavaScript" },
      { name: "HTML" },
      { name: "CSS" },
      { name: "Tailwind CSS" },
    ],
  },
  {
    id: "backend",
    category: "backend",
    label: "Backend",
    badge: "APIs & Logic",
    skills: [
      { name: "Python" },
      { name: "FastAPI" },
      { name: "REST APIs" },
      { name: "SQLAlchemy" },
      { name: "SQL" },
    ],
  },
  {
    id: "ai",
    category: "ai",
    label: "AI",
    badge: "LLMs & Vectors",
    skills: [
      { name: "RAG" },
      { name: "Embeddings" },
      { name: "Gemini API" },
      { name: "Groq API" },
    ],
  },
  {
    id: "database",
    category: "database",
    label: "Database and vector",
    badge: "Storage & Search",
    skills: [
      { name: "Neon (PostgreSQL)" },
      { name: "Pinecone" },
    ],
  },
  {
    id: "automation",
    category: "automation",
    label: "Automation",
    badge: "Pipelines",
    skills: [
      { name: "n8n" },
    ],
  },
  {
    id: "tools",
    category: "tools",
    label: "Tools",
    badge: "DevOps & Auth",
    skills: [
      { name: "Git" },
      { name: "GitHub" },
      { name: "Vercel" },
      { name: "Clerk" },
    ],
  },
  {
    id: "ai-tools",
    category: "tools",
    label: "AI tools",
    badge: "Workflows",
    skills: [
      { name: "Claude" },
      { name: "Antigravity IDE" },
    ],
  },
