---
// Education / study journey – formal qualifications and courses.
const formal = [
  {
    title: "Bachelor of Science in Computer Science (BS CS)",
    place: "Virtual University of Pakistan",
    period: "Continuing",
    location: "Pakistan",
    status: "In Progress",
  },
  {
    title: "Intermediate in Computer Science (ICS)",
    place: "Govt. M.C. Higher Secondary School, G.M. Abad",
    period: "April 2024 — September 2026",
    location: "Faisalabad, Pakistan",
    status: "Completed",
  },
  {
    title: "Matriculation",
    place: "Hassan Bin Sabit High School",
    period: "2021 — 2023",
    location: "Faisalabad, Pakistan",
    status: "Completed",
  },
  {
    title: "Hifz-ul-Quran",
    place: "Al-Rehman Islamic Center",
    period: "2017 — 2020",
    location: null,
    status: "Completed",
  },
];

const courses = [
  {
    title: "AI and Data Science",
    place: "Saylani Mass IT Training (SMIT)",
    period: "Nov 2025 — Nov 2026",
    badge: "Specialization",
  },
  {
    title: "Digital Marketing",
    place: "SDI Welfare",
    period: "Aug 2026 — Oct 2026",
    badge: "Certified",
  },
  {
    title: "Web Development",
    place: "Self-learning",
    period: "Ongoing",
    badge: "Independent",
  },
  {
    title: "Introduction to Artificial Intelligence",
    place: "Cisco Networking Academy",
    period: "Online",
    badge: "Certificate",
  },
  {
    title: "MS Office",
    place: "SoftWiz Solutions and Institute",
    period: "2024 · 3 months",
    badge: "Completed",
  },
];
---

<section id="education" aria-labelledby="education-heading">
  <div class="site-container">
    <div class="education-header">
      <h2 id="education-heading" class="education-heading">Study journey</h2>
    </div>

    <!-- Dual-Column Credentials Showcase -->
    <div class="education-columns">
      <!-- Left Column: Formal Degrees -->
      <div class="edu-column">
        <div class="column-header">
          <div class="col-icon-wrap" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
              <path d="M6 12v5c3 3 9 3 12 0v-5" />
            </svg>
          </div>
          <div>
            <h3 class="col-title">Formal education</h3>
            <p class="col-desc">Academic foundation & degree pursuits</p>
          </div>
        </div>

        <div class="credentials-list" role="list">
          {formal.map((item) => (
            <div class="credential-item" role="listitem">
              <div class="item-header">
                <h4 class="item-title">{item.title}</h4>
                {item.status === 'In Progress' ? (
                  <span class="status-badge is-progress">{item.status}</span>
                ) : (
                  <span class="status-badge">{item.period}</span>
                )}
              </div>
              <p class="item-place">{item.place}</p>
              <div class="item-meta">
                {item.location && <span class="meta-tag">{item.location}</span>}
                {item.status === 'In Progress' && <span class="meta-tag">{item.period}</span>}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right Column: Courses & Technical Certifications -->
      <div class="edu-column">
        <div class="column-header">
          <div class="col-icon-wrap" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="8" r="6" />
              <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11" />
            </svg>
          </div>
          <div>
            <h3 class="col-title">Courses & certifications</h3>
            <p class="col-desc">Practical training & verified skillsets</p>
          </div>
        </div>

        <div class="credentials-list" role="list">
          {courses.map((item) => (
            <div class="credential-item" role="listitem">
              <div class="item-header">
                <h4 class="item-title">{item.title}</h4>
                <span class="status-badge cert-badge">{item.badge}</span>
              </div>
              <p class="item-place">{item.place}</p>
              <div class="item-meta">
                <span class="meta-tag">{item.period}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #education {
    padding-top: var(--section-py);
    padding-bottom: var(--section-py);
    border-bottom: 1px solid var(--border);
  }

  .education-header {
    margin-bottom: var(--space-48);
  }

  .education-heading {
    margin: 0;
  }

  /* Dual-Column Layout */
  .education-columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-48);
  }

  @media (min-width: 840px) {
    .education-columns {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-48);
    }
  }

  .edu-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  /* Column Header */
  .column-header {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    padding-bottom: var(--space-16);
    border-bottom: 1px solid var(--border);
  }

  .col-icon-wrap {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: var(--surface);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    flex-shrink: 0;
  }

  .col-icon-wrap svg {
    width: 18px;
    height: 18px;
  }

  .col-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
    margin: 0;
    line-height: 1.3;
  }

  .col-desc {
    font-size: 12px;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.3;
  }

  /* Credentials List */
  .credentials-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .credential-item {
    padding: var(--space-16);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-tag);
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .credential-item:hover {
    transform: translateY(-2px);
    border-color: rgba(10, 132, 255, 0.35);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  :root[data-theme="dark"] .credential-item:hover {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
  }

  .item-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-12);
  }

  .item-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
    margin: 0;
    line-height: 1.35;
  }

  .item-place {
    font-size: var(--font-size-small);
    color: var(--text-muted);
    margin: 0;
    line-height: 1.35;
  }

  .item-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 2px;
  }

  .meta-tag {
    font-size: 12px;
    color: var(--text-muted);
  }

  .status-badge {
    font-size: 11px;
    font-weight: 500;
    color: var(--text-muted);
    background: var(--bg);
    border: 1px solid var(--border);
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .status-badge.is-progress {
    color: #10B981;
    border-color: rgba(16, 185, 129, 0.3);
    background: rgba(16, 185, 129, 0.08);
    font-weight: 600;
  }

  .status-badge.cert-badge {
    color: var(--accent);
    border-color: rgba(10, 132, 255, 0.25);
    background: rgba(10, 132, 255, 0.06);
  }

  @media (prefers-reduced-motion: reduce) {
    .credential-item {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
