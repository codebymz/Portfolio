---
// Experience entries – work and internships, newest first.
// Arabic teacher is now shown per owner decision (2026-10-05).
// ICS moved to EducationSection.
const entries = [
  {
    title: "Founder and Full-Stack Developer",
    place: "MZ Nexora",
    period: "August 2026 — present",
    location: "Faisalabad, Pakistan",
    badge: null,
  },
  {
    title: "Digital Marketing intern",
    place: "SDI Welfare",
    period: "August 2026 — October 2026",
    location: null,
    badge: null,
    note: null,
  },
  {
    title: "Arabic teacher",
    place: "Alliance Public School",
    period: "~1 year", // exact start/end dates: TODO (owner to confirm)
    location: "Faisalabad, Pakistan",
    badge: null,
  },
  {
    title: "AI and Data Science",
    place: "Saylani Mass IT Training (SMIT)",
    period: "November 2025 — November 2026",
    location: null,
    badge: null,
  },
];
---

<section id="experience" aria-labelledby="experience-heading">
  <div class="site-container">
    <h2 id="experience-heading" class="experience-heading">Experience</h2>
    <ol class="timeline" role="list">
      {entries.map((entry) => (
        <li class="timeline-entry">
          <div class="timeline-marker" aria-hidden="true"></div>
          <div class="timeline-body">
            <div class="entry-header">
              <p class="entry-title">{entry.title}</p>
              <p class="entry-place">{entry.place}</p>
            </div>
            <div class="entry-meta">
              {entry.period && entry.location ? (
                <span class="entry-period-location">{entry.period} · {entry.location}</span>
              ) : entry.period ? (
                <span class="entry-period-location">{entry.period}</span>
              ) : entry.location ? (
                <span class="entry-period-location">{entry.location}</span>
              ) : null}
              {entry.badge && (
                <span class="entry-badge">{entry.badge}</span>
              )}
            </div>
            {entry.note && (
              <p class="entry-note">{entry.note}</p>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  #experience {
    padding-top: var(--section-py);
    padding-bottom: var(--section-py);
    border-bottom: 1px solid var(--border);
  }

  .experience-heading {
    margin-bottom: var(--space-48);
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }

  /* Vertical line */
  .timeline::before {
    content: "";
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: 7px;
    width: 1px;
    background-color: var(--border);
  }

  .timeline-entry {
    display: flex;
    gap: var(--space-24);
    position: relative;
    padding-bottom: 40px;
  }

  .timeline-entry:last-child {
    padding-bottom: 0;
  }

  .timeline-marker {
    flex-shrink: 0;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    background-color: var(--bg);
    margin-top: 3px;
    position: relative;
    z-index: 1;
  }

  .timeline-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-bottom: var(--space-8);
  }

  .entry-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .entry-title {
    font-size: var(--font-size-body);
    font-weight: 600;
    color: var(--text);
    margin: 0;
    max-width: none;
  }

  .entry-place {
    font-size: var(--font-size-body);
    color: var(--text-muted);
    margin: 0;
    max-width: none;
  }

  .entry-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-8);
    margin-top: var(--space-4);
  }

  .entry-period-location {
    font-size: var(--font-size-small);
    color: var(--text-muted);
    font-weight: 500;
  }

  .entry-badge {
    font-size: var(--font-size-small);
    font-weight: 500;
    border: 1px solid var(--border);
    border-radius: var(--radius-tag);
    padding: 2px 8px;
    color: var(--text-muted);
    line-height: var(--line-height-small);
  }

  .entry-note {
    font-size: var(--font-size-small);
    color: var(--text-muted);
    margin: var(--space-4) 0 0;
    max-width: 55ch;
  }
</style>
