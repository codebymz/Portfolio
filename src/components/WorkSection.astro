---
// Work section component following design.md section 6 and data.md section 5
import { featuredProjects, otherProjects } from '../data/projects';
---

<section id="work" class="work-section" aria-label="Work">
  <div class="site-container">
    <div class="section-header">
      <h2 class="text-h2">Work</h2>
      <p class="section-desc">Featured projects and selected work.</p>
    </div>

    <!-- Featured Projects Rows with Alternating Layout -->
    <div class="featured-list" role="list">
      {featuredProjects.map((project, index) => {
        const isReversed = index % 2 === 1; // 1st & 3rd: Left pic / Right text | 2nd & 4th: Right pic / Left text
        return (
          <article class={`project-row ${isReversed ? 'row-reversed' : ''}`} role="listitem">
            <!-- Screenshot or Video box -->
            <div class="screenshot-col">
              {project.videoUrl ? (
                <div class="screenshot-placeholder media-has-content">
                  <video
                    src={project.videoUrl}
                    poster={project.screenshot && project.screenshot !== 'TODO' ? project.screenshot : undefined}
                    autoplay
                    loop
                    muted
                    playsinline
                    class="project-media-video"
                  ></video>
                </div>
              ) : project.screenshot && project.screenshot !== 'TODO' ? (
                <div class="screenshot-placeholder media-has-content media-animated">
                  <a href={`/projects/${project.slug}`} class="project-media-link" aria-label={`View ${project.title} details`}>
                    <img
                      src={project.screenshot}
                      alt={`${project.title} screenshot`}
                      class="project-media-img"
                      loading="lazy"
                    />
                    <div class="media-sheen" aria-hidden="true"></div>
                  </a>
                </div>
              ) : (
                <div class="screenshot-placeholder" aria-label={`${project.title} screenshot placeholder`}>
                  <span class="placeholder-title">{project.title}</span>
                  <span class="placeholder-label">Screenshot (TODO)</span>
                </div>
              )}
            </div>

            <!-- Text Details -->
            <div class="text-col">
              <h3 class="text-h3 project-title">
                <a href={`/projects/${project.slug}`} class="project-title-link">
                  {project.title}
                </a>
              </h3>

              <p class="project-summary">{project.summary}</p>

              <div class="tag-group" aria-label="Technologies used">
                {Array.isArray(project.stack) ? (
                  project.stack.map((tech) => <span class="tag">{tech}</span>)
                ) : (
                  <span class="tag tag-todo">Stack: TODO</span>
                )}
              </div>

              <div class="project-links">
                {project.liveUrl && (
                  <a
                    href={project.liveUrl}
                    class="btn btn-primary"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Open live site
                  </a>
                )}
                {project.isComingSoon && (
                  <span class="status-label">Coming soon</span>
                )}

                {project.githubUrl && (
                  <a
                    href={project.githubUrl}
                    class="btn btn-secondary glass"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    View on GitHub
                  </a>
                )}
                {project.isPrivateRepo && (
                  <span class="status-label">Private repository</span>
                )}

                <a href={`/projects/${project.slug}`} class="btn btn-secondary glass">
                  View details
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    {otherProjects.length > 0 && (
      <div class="other-projects-section">
        <h3 class="other-projects-heading">Other projects</h3>

        <div class="other-projects-list" role="list">
          {otherProjects.map((project) => (
            <article class="other-project-item" role="listitem">
              <div class="other-project-main">
                <div class="other-project-title-row">
                  <span class="other-project-name">{project.name}</span>
                  <div class="tag-group">
                    {Array.isArray(project.stack) ? (
                      project.stack.map((tech) => <span class="tag">{tech}</span>)
                    ) : (
                      <span class="tag tag-todo">Stack: TODO</span>
                    )}
                  </div>
                </div>
                <p class="other-project-desc">{project.description}</p>
              </div>

              <div class="other-project-links">
                {project.liveUrl && (
                  <a
                    href={project.liveUrl}
                    class="btn btn-primary"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Open live site
                  </a>
                )}
                {project.githubUrl && (
                  <a
                    href={project.githubUrl}
                    class="btn btn-secondary glass"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    View on GitHub
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .work-section {
    padding-top: var(--section-py);
    padding-bottom: var(--section-py);
  }

  .section-header {
    margin-bottom: var(--space-48);
  }

  .section-desc {
    color: var(--text-muted);
    font-size: var(--font-size-body);
    margin-top: var(--space-8);
  }

  /* Featured project rows */
  .featured-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-96);
  }

  .project-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
    align-items: center;
    width: 100%;
  }

  .screenshot-col {
    width: 100%;
  }

  .text-col {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    align-items: flex-start;
  }

  /* Alternating 2-column layout on screens 768px and up */
  @media (min-width: 768px) {
    .project-row {
      flex-direction: row;
      gap: var(--space-48);
      align-items: center;
    }

    .screenshot-col {
      flex: 7;
      min-width: 0;
      width: auto;
    }

    .text-col {
      flex: 5;
      min-width: 0;
      width: auto;
    }

    /* Project 2 & 4: Flips pic to Right and details to Left */
    .project-row.row-reversed {
      flex-direction: row-reverse;
    }
  }

  /* Screenshot placeholder (radius 20px, 1px border) */
  .screenshot-placeholder {
    width: 100%;
    aspect-ratio: 16 / 10;
    min-height: 220px;
    border: 1px solid var(--border);
    border-radius: var(--radius-media);
    background-color: var(--surface);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-8);
    padding: var(--space-24);
    text-align: center;
    overflow: hidden;
    position: relative;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease;
  }

  .media-has-content {
    padding: 0;
  }

  .media-animated {
    animation: media-float 7s ease-in-out infinite;
    box-shadow: 0 8px 24px -6px rgba(0, 0, 0, 0.08), 0 0 20px -5px rgba(0, 102, 214, 0.12);
  }

  :root[data-theme="dark"] .media-animated {
    box-shadow: 0 12px 36px -10px rgba(0, 0, 0, 0.5), 0 0 25px -4px rgba(10, 132, 255, 0.22);
  }

  .screenshot-placeholder.media-has-content:hover {
    transform: translateY(-8px) scale(1.015);
    border-color: rgba(0, 102, 214, 0.4);
    box-shadow: 0 20px 45px -10px rgba(0, 102, 214, 0.22), 0 0 30px -2px rgba(0, 180, 255, 0.25);
  }

  :root[data-theme="dark"] .screenshot-placeholder.media-has-content:hover {
    border-color: rgba(10, 132, 255, 0.6);
    box-shadow: 0 24px 50px -10px rgba(0, 0, 0, 0.7), 0 0 35px 2px rgba(10, 132, 255, 0.4);
  }

  .project-media-link {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    text-decoration: none;
    cursor: pointer;
  }

  .project-media-video,
  .project-media-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), filter 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-media-img {
    filter: grayscale(100%) contrast(1.02);
  }

  .screenshot-placeholder.media-has-content:hover .project-media-img,
  .screenshot-placeholder.media-has-content:focus-within .project-media-img {
    filter: grayscale(0%) contrast(1);
    transform: scale(1.045);
  }

  .media-sheen {
    position: absolute;
    top: 0;
    left: -120%;
    width: 60%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.24),
      transparent
    );
    transform: skewX(-20deg);
    pointer-events: none;
    transition: left 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :root[data-theme="dark"] .media-sheen {
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.16),
      transparent
    );
  }

  .screenshot-placeholder.media-has-content:hover .media-sheen {
    left: 150%;
  }

  @keyframes media-float {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .media-animated {
      animation: none;
    }
    .screenshot-placeholder,
    .project-media-img,
    .media-sheen {
      transition: none;
      transform: none !important;
    }
  }

  .placeholder-title {
    font-size: var(--font-size-body);
    font-weight: 600;
    color: var(--text);
  }

  .placeholder-label {
    font-size: var(--font-size-small);
    color: var(--text-muted);
  }

  .project-title {
    margin: 0;
  }

  .project-title-link {
    color: var(--text);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .project-title-link:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .project-summary {
    color: var(--text-muted);
    margin: 0;
    line-height: var(--line-height-body);
  }

  .tag-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  .tag-todo {
    border-style: dashed;
    color: var(--text-muted);
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-12);
    margin-top: var(--space-8);
  }

  /* Other projects: plain list, no cards */
  .other-projects-section {
    margin-top: var(--space-96);
    padding-top: var(--space-48);
    border-top: 1px solid var(--border);
  }

  .other-projects-heading {
    font-size: var(--font-size-h3);
    font-weight: 600;
    color: var(--text);
    margin-bottom: var(--space-24);
  }

  .other-projects-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  .other-project-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    padding-bottom: var(--space-24);
    border-bottom: 1px solid var(--border);
  }

  .other-project-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  @media (min-width: 640px) {
    .other-project-item {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
      gap: var(--space-24);
    }
  }

  .other-project-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .other-project-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-12);
  }

  .other-project-name {
    font-size: var(--font-size-body);
    font-weight: 600;
    color: var(--text);
  }

  .other-project-desc {
    font-size: var(--font-size-small);
    color: var(--text-muted);
    margin: 0;
    max-width: 60ch;
  }

  .other-project-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-16);
    flex-shrink: 0;
  }
</style>
