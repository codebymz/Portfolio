---
import ThemeToggle from './ThemeToggle.astro';

const navLinks = [
  { href: '#work', label: 'Work', icon: 'work' },
  { href: '#about', label: 'About', icon: 'about' },
  { href: '#skills', label: 'Skills', icon: 'skills' },
  { href: '#experience', label: 'Experience', icon: 'experience' },
  { href: '#contact', label: 'Contact', icon: 'contact' },
];
---

<header class="navbar-wrapper">
  <div class="navbar-controls">
    <a href="#home" class="glass navbar-mark" aria-label="MZ home">MZ</a>

    <nav class="glass navbar-pill" aria-label="Main navigation">
      <ul class="nav-links desktop-only" role="list">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class:list={['nav-link', link.href === '#home' && 'is-active']} data-nav-link>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                {link.icon === 'home' && <><path d="m3 10 9-7 9 7" /><path d="M5 9v12h14V9M9 21v-7h6v7" /></>}
                {link.icon === 'work' && <><rect x="3" y="7" width="18" height="13" rx="2" /><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18" /></>}
                {link.icon === 'about' && <><circle cx="12" cy="8" r="3.5" /><path d="M5 21v-2a7 7 0 0 1 14 0v2" /></>}
                {link.icon === 'skills' && <><path d="M4 5h16M4 12h16M4 19h16" /><circle cx="8" cy="5" r="1.5" /><circle cx="15" cy="12" r="1.5" /><circle cx="10" cy="19" r="1.5" /></>}
                {link.icon === 'experience' && <><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></>}
                {link.icon === 'contact' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></>}
              </svg>
              <span>{link.label}</span>
            </a>
          </li>
        ))}
      </ul>

      <button
        type="button"
        id="mobile-menu-btn"
        class="mobile-menu-btn mobile-only"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav-sheet"
      >
        <!-- Hamburger icon -->
        <svg
          class="menu-icon hamburger"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="4" y1="7" x2="20" y2="7"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="17" x2="20" y2="17"></line>
        </svg>
        <!-- Close icon -->
        <svg
          class="menu-icon close-x"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </nav>
    <ThemeToggle />
  </div>

  <!-- Mobile Glass Sheet -->
  <nav
    id="mobile-nav-sheet"
    class="glass mobile-sheet mobile-only"
    hidden
    aria-label="Mobile navigation"
  >
    <ul class="mobile-nav-links" role="list">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} class:list={['mobile-nav-link', link.href === '#home' && 'is-active']} data-nav-link>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              {link.icon === 'home' && <><path d="m3 10 9-7 9 7" /><path d="M5 9v12h14V9M9 21v-7h6v7" /></>}
              {link.icon === 'work' && <><rect x="3" y="7" width="18" height="13" rx="2" /><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18" /></>}
              {link.icon === 'about' && <><circle cx="12" cy="8" r="3.5" /><path d="M5 21v-2a7 7 0 0 1 14 0v2" /></>}
              {link.icon === 'skills' && <><path d="M4 5h16M4 12h16M4 19h16" /><circle cx="8" cy="5" r="1.5" /><circle cx="15" cy="12" r="1.5" /><circle cx="10" cy="19" r="1.5" /></>}
              {link.icon === 'experience' && <><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></>}
              {link.icon === 'contact' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></>}
            </svg>
            <span>{link.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .navbar-wrapper {
    position: fixed;
    top: calc(16px + env(safe-area-inset-top, 0px));
    left: 0;
    right: 0;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 16px;
    pointer-events: none;
  }

  .navbar-pill {
    pointer-events: auto;
    width: auto;
    max-width: 760px;
    height: 56px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 12px;
  }

  .navbar-controls {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: fit-content;
    max-width: 100%;
  }

  .navbar-mark {
    width: 48px;
    height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    border-radius: 50%;
    color: var(--text);
    font-size: var(--font-size-small);
    font-weight: 700;
    text-decoration: none;
  }

  .navbar-mark:hover {
    text-decoration: none;
    opacity: 0.85;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    font-size: var(--font-size-small);
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 150ms ease;
    min-height: 44px;
    padding: 0 12px;
    border-radius: 999px;
    white-space: nowrap;
  }

  .nav-link svg,
  .mobile-nav-link svg {
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .nav-link:hover {
    color: var(--text);
    text-decoration: none;
  }

  .nav-link.is-active {
    color: var(--bg);
    background-color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }

  .mobile-menu-btn {
    width: 44px;
    height: 44px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--text);
    padding: 0;
    border: 0;
    background: transparent;
    transition: opacity 150ms ease;
  }

  .mobile-menu-btn:hover {
    opacity: 0.85;
  }

  .mobile-menu-btn .close-x {
    display: none;
  }

  .mobile-menu-btn[aria-expanded="true"] .hamburger {
    display: none;
  }

  .mobile-menu-btn[aria-expanded="true"] .close-x {
    display: block;
  }

  /* Mobile Sheet */
  .mobile-sheet {
    pointer-events: auto;
    width: calc(100% - 52px);
    max-width: 760px;
    margin-top: 10px;
    border-radius: 20px;
    padding: 16px 20px;
  }

  .mobile-sheet[hidden] {
    display: none;
  }

  .mobile-nav-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    min-height: 44px;
    font-size: var(--font-size-body);
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    border-radius: 12px;
    transition: color 150ms ease;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.is-active {
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }

  .mobile-nav-link.is-active {
    background-color: var(--text);
    color: var(--bg);
  }

  /* Responsive visibility */
  .mobile-only {
    display: none;
  }

  .desktop-only {
    display: flex;
  }

  @media (max-width: 639px) {
    .navbar-controls {
      width: 100%;
    }

    .navbar-mark {
      width: 44px;
      height: 44px;
    }

    .mobile-only {
      display: inline-flex;
    }
    .mobile-sheet.mobile-only:not([hidden]) {
      display: block;
    }
    .desktop-only {
      display: none;
    }
    .navbar-pill {
      flex: 1;
      justify-content: center;
      padding: 0 8px;
    }
  }

  @media (min-width: 640px) and (max-width: 800px) {
    .nav-links {
      gap: 0;
    }

    .nav-link {
      gap: 4px;
      padding: 0 6px;
      font-size: 12px;
    }
  }
</style>

<script>
  function setupNavbar() {
    const menuBtn = document.getElementById('mobile-menu-btn');
    const sheet = document.getElementById('mobile-nav-sheet');
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');

    function toggleMenu(open?: boolean) {
      if (!menuBtn || !sheet) return;
      const isOpen = open !== undefined ? open : menuBtn.getAttribute('aria-expanded') === 'true';
      const nextState = !isOpen;
      menuBtn.setAttribute('aria-expanded', nextState ? 'true' : 'false');
      menuBtn.setAttribute('aria-label', nextState ? 'Close menu' : 'Open menu');
      if (nextState) {
        sheet.removeAttribute('hidden');
      } else {
        sheet.setAttribute('hidden', '');
      }
    }

    if (menuBtn && sheet) {
      menuBtn.addEventListener('click', () => toggleMenu());

      // Close when clicking any link
      links.forEach((link) => {
        link.addEventListener('click', () => {
          if (window.innerWidth < 640) {
            toggleMenu(false);
          }
        });
      });

      // Close on escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menuBtn.getAttribute('aria-expanded') === 'true') {
          toggleMenu(false);
        }
      });
    }

    // Active link highlighting via IntersectionObserver
    const sections = document.querySelectorAll<HTMLElement>('section[id], header[id], div[id]');
    const sectionIds = Array.from(links)
      .map((l) => l.getAttribute('href')?.replace('#', ''))
      .filter(Boolean) as string[];

    const observedSections = Array.from(sections).filter((sec) => sectionIds.includes(sec.id));

    if (observedSections.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const id = entry.target.id;
              links.forEach((link) => {
                const href = link.getAttribute('href');
                if (href === `#${id}`) {
                  link.classList.add('is-active');
                } else if (href?.startsWith('#')) {
                  link.classList.remove('is-active');
                }
              });
            }
          });
        },
        {
          rootMargin: '-20% 0px -60% 0px',
          threshold: 0,
        }
      );

      observedSections.forEach((sec) => observer.observe(sec));
    }
  }

  setupNavbar();
  document.addEventListener('astro:after-swap', setupNavbar);
</script>
