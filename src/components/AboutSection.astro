---

<section id="about" aria-labelledby="about-heading">
  <div class="site-container">
    <div class="about-inner">
      <h2 id="about-heading" class="about-heading">About</h2>

      <div class="about-body">
        <!-- Text column (left) -->
        <div class="about-text">
          <p>I'm Zain, a full-stack developer from Faisalabad, Pakistan. I build web apps with Next.js, React and FastAPI, and I use AI tools to work faster while I handle the design, architecture and debugging myself.</p>
          <p>So far I've built a school management portal, an AI paper generator for students, a QR ordering system for a restaurant, and a few tools of my own. I also run MZ Nexora, a small digital agency, and I'm studying AI and Data Science at SMIT.</p>
          <p>I'm open to internships, freelance work and remote roles.</p>
        </div>

        <!-- Profile photo column (right) -->
        <div class="about-photo-wrap">
          <div class="about-photo-card">
            <img
              src="/about-photo.jpg"
              alt="Muhammad Zain Ul Abdin – portrait"
              class="about-photo-img"
              loading="lazy"
              width="768"
              height="1024"
            />
            <div class="photo-sheen" aria-hidden="true"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #about {
    padding-top: var(--section-py);
    padding-bottom: var(--section-py);
    border-bottom: 1px solid var(--border);
  }

  .about-inner {
    max-width: var(--container-max-w);
  }

  .about-heading {
    margin-bottom: var(--space-48);
  }

  /* Two-column layout: text (left) + photo (right) */
  .about-body {
    display: flex;
    flex-direction: column-reverse; /* photo above text on mobile */
    gap: var(--space-48);
    align-items: center;
  }

  @media (min-width: 640px) {
    .about-body {
      flex-direction: row;       /* text left, photo right */
      align-items: center;
      gap: clamp(36px, 5vw, 64px);
    }
  }

  /* ── Text column ── */
  .about-text {
    flex: 1;
    min-width: 0;
  }

  .about-text p {
    color: var(--text);
    text-align: justify;
    margin-bottom: var(--space-24);
    line-height: var(--line-height-body);
  }

  .about-text p:last-child {
    margin-bottom: 0;
  }

  /* ── Photo column (right) ── */
  .about-photo-wrap {
    flex-shrink: 0;
    width: clamp(200px, 28vw, 300px);
    display: flex;
    justify-content: center;
  }

  /* Circular card with border that turns blue on hover */
  .about-photo-card {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;   /* perfect circle */
    border-radius: 50%;
    overflow: hidden;
    cursor: default;

    /* Theme-aware background */
    background-color: #E8E8ED;

    /* Single-line border — turns blue on hover */
    border: 2px solid var(--border);

    /* Ambient float */
    animation: about-float 7s ease-in-out infinite;

    transition:
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.35s ease;

    box-shadow:
      0 8px 24px -6px rgba(0, 0, 0, 0.08),
      0 0 20px -5px rgba(0, 102, 214, 0.10);
  }

  :root[data-theme="dark"] .about-photo-card {
    background-color: #2C2C2E;
    box-shadow:
      0 12px 36px -10px rgba(0, 0, 0, 0.55),
      0 0 25px -4px rgba(10, 132, 255, 0.18);
  }

  /* Hover: lift + blue border */
  .about-photo-card:hover {
    transform: translateY(-8px) scale(1.04);
    border-color: var(--accent);                  /* solid blue line */
    box-shadow:
      0 20px 45px -10px rgba(0, 102, 214, 0.28),
      0 0 0 4px rgba(0, 102, 214, 0.12);          /* soft outer blue glow ring */
    animation-play-state: paused;
  }

  :root[data-theme="dark"] .about-photo-card:hover {
    border-color: var(--accent);
    box-shadow:
      0 24px 50px -10px rgba(0, 0, 0, 0.65),
      0 0 0 4px rgba(10, 132, 255, 0.22);
  }

  /* Grayscale by default → color on hover */
  .about-photo-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;

    filter: grayscale(100%) contrast(1.05);
    transition:
      filter 0.55s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .about-photo-card:hover .about-photo-img {
    filter: grayscale(0%) contrast(1);
    transform: scale(1.06);
  }

  /* Sheen sweep */
  .photo-sheen {
    position: absolute;
    top: 0;
    left: -130%;
    width: 60%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.22),
      transparent
    );
    transform: skewX(-20deg);
    pointer-events: none;
    transition: left 0.75s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :root[data-theme="dark"] .photo-sheen {
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.14),
      transparent
    );
  }

  .about-photo-card:hover .photo-sheen {
    left: 160%;
  }

  /* Float keyframe */
  @keyframes about-float {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-7px); }
  }

  /* Reduced-motion fallback */
  @media (prefers-reduced-motion: reduce) {
    .about-photo-card {
      animation: none;
    }
    .about-photo-card,
    .about-photo-img,
    .photo-sheen {
      transition: none;
      transform: none !important;
    }
    .about-photo-card:hover .about-photo-img {
      filter: grayscale(0%) contrast(1);
    }
  }
</style>
