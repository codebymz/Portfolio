<section id="contact" aria-labelledby="contact-heading">
  <div class="site-container">
    <div class="contact-inner">
      <h2 id="contact-heading" class="contact-heading">Contact</h2>
      <p class="contact-intro">Get in touch by email, or find me on LinkedIn and GitHub.</p>
      <div class="contact-actions">
        <a
          id="contact-email"
          href="mailto:hz880710@gmail.com"
          class="btn btn-primary"
        >
          Send me an email
        </a>
        <a
          id="contact-linkedin"
          href="https://www.linkedin.com/in/devmzainulabdin"
          class="btn btn-secondary glass"
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn
        </a>
        <a
          id="contact-github"
          href="https://github.com/codebymz"
          class="btn btn-secondary glass"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  #contact {
    padding-top: var(--section-py);
    padding-bottom: var(--section-py);
  }

  .contact-inner {
    max-width: var(--text-column-max-w);
  }

  .contact-heading {
    margin-bottom: var(--space-16);
  }

  .contact-intro {
    color: var(--text-muted);
    margin-bottom: var(--space-32);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-16);
  }
</style>
