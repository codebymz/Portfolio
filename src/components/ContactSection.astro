---
// Contact section – direct channels and message form.
// Uses details from data.md.
const email = "zzawar521@gmail.com";
const whatsapp = "+923269656457";
const whatsappLink = "https://wa.me/923269656457";
const linkedin = "https://www.linkedin.com/in/devmzainulabdin";
const github = "https://github.com/codebymz";
---

<section id="contact" aria-labelledby="contact-heading">
  <div class="site-container">
    <div class="contact-wrapper">
      <!-- Left Column: Context, Direct Links, Availability -->
      <div class="contact-info-col">
        <div class="contact-eyebrow">
          <span class="eyebrow-dot" aria-hidden="true"></span>
          <span>Get in Touch</span>
        </div>

        <h2 id="contact-heading" class="contact-heading">
          Let’s build something together.
        </h2>

        <p class="contact-intro">
          I’m always open to discussing new projects, internships, freelance opportunities, or technical collaborations. Feel free to reach out directly through any of these platforms.
        </p>

        <!-- Availability Status Pill -->
        <div class="availability-pill" role="status">
          <span class="avail-dot" aria-hidden="true"></span>
          <span>Available for internships, freelance & remote roles</span>
        </div>

        <!-- Direct Channels List -->
        <div class="channels-grid">
          <!-- Email Card -->
          <a
            id="contact-email"
            href={`mailto:${email}`}
            class="channel-item"
            title="Send an email"
          >
            <div class="channel-icon-wrap" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2" />
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
              </svg>
            </div>
            <div class="channel-text">
              <span class="channel-label">Email</span>
              <span class="channel-value">{email}</span>
            </div>
            <div class="channel-action" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M7 17 17 7M7 7h10v10" />
              </svg>
            </div>
          </a>

          <!-- WhatsApp Card -->
          <a
            id="contact-whatsapp"
            href={whatsappLink}
            class="channel-item"
            target="_blank"
            rel="noopener noreferrer"
            title="Chat on WhatsApp"
          >
            <div class="channel-icon-wrap icon-whatsapp" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
              </svg>
            </div>
            <div class="channel-text">
              <span class="channel-label">WhatsApp</span>
              <span class="channel-value">+92 326 9656457</span>
            </div>
            <div class="channel-action" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M7 17 17 7M7 7h10v10" />
              </svg>
            </div>
          </a>

          <!-- LinkedIn Card -->
          <a
            id="contact-linkedin"
            href={linkedin}
            class="channel-item"
            target="_blank"
            rel="noopener noreferrer"
            title="Connect on LinkedIn"
          >
            <div class="channel-icon-wrap icon-linkedin" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                <rect width="4" height="12" x="2" y="9" />
                <circle cx="4" cy="4" r="2" />
              </svg>
            </div>
            <div class="channel-text">
              <span class="channel-label">LinkedIn</span>
              <span class="channel-value">in/devmzainulabdin</span>
            </div>
            <div class="channel-action" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M7 17 17 7M7 7h10v10" />
              </svg>
            </div>
          </a>

          <!-- GitHub Card -->
          <a
            id="contact-github"
            href={github}
            class="channel-item"
            target="_blank"
            rel="noopener noreferrer"
            title="View GitHub profile"
          >
            <div class="channel-icon-wrap" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                <path d="M9 18c-4.51 2-5-2-7-2" />
              </svg>
            </div>
            <div class="channel-text">
              <span class="channel-label">GitHub</span>
              <span class="channel-value">github.com/codebymz</span>
            </div>
            <div class="channel-action" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M7 17 17 7M7 7h10v10" />
              </svg>
            </div>
          </a>
        </div>
      </div>

      <!-- Right Column: Interactive Contact Form Card -->
      <div class="contact-form-card">
        <div class="form-header">
          <h3 class="form-title">Send a direct message</h3>
          <p class="form-subtitle">Fill in the fields below and it will prepare your email instantly.</p>
        </div>

        <form id="contact-form" class="contact-form">
          <div class="field-group">
            <label for="contact-name" class="field-label">
              <span>Your Name</span>
              <span class="req">*</span>
            </label>
            <div class="input-wrap">
              <input
                id="contact-name"
                name="name"
                type="text"
                autocomplete="name"
                placeholder="e.g. Alex Smith"
                required
              />
            </div>
          </div>

          <div class="field-group">
            <label for="contact-reply" class="field-label">
              <span>Email or Phone</span>
              <span class="req">*</span>
            </label>
            <div class="input-wrap">
              <input
                id="contact-reply"
                name="reply"
                type="text"
                autocomplete="email"
                placeholder="e.g. alex@example.com"
                required
              />
            </div>
          </div>

          <div class="field-group">
            <label for="contact-details" class="field-label">
              <span>Project Details & Message</span>
              <span class="req">*</span>
            </label>
            <div class="input-wrap">
              <textarea
                id="contact-details"
                name="details"
                rows="4"
                placeholder="Describe your project, role opportunity, or timeline..."
                required
              ></textarea>
            </div>
          </div>

          <button id="contact-submit-btn" class="btn btn-primary submit-btn" type="submit">
            <span>Send Message</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="22" y1="2" x2="11" y2="13" />
              <polygon points="22 2 15 22 11 13 2 9 22 2" />
            </svg>
          </button>
        </form>

        <p class="contact-form-note">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="16" x2="12" y2="12" />
            <line x1="12" y1="8" x2="12.01" y2="8" />
          </svg>
          <span>Submitting opens a pre-composed email draft ready to send.</span>
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  function setupContactForm() {
    const contactForm = document.querySelector<HTMLFormElement>('#contact-form');
    const submitBtn = document.querySelector<HTMLButtonElement>('#contact-submit-btn');

    if (!contactForm) return;

    contactForm.addEventListener('submit', (event) => {
      event.preventDefault();
      const formData = new FormData(contactForm);
      const name = String(formData.get('name') ?? '').trim();
      const reply = String(formData.get('reply') ?? '').trim();
      const details = String(formData.get('details') ?? '').trim();
      
      const subject = encodeURIComponent(`Project Inquiry from ${name}`);
      const body = encodeURIComponent(`Hello Zain,\n\n${details}\n\n---\nName: ${name}\nContact: ${reply}`);

      if (submitBtn) {
        const originalText = submitBtn.innerHTML;
        submitBtn.innerHTML = `<span>Opening Mail...</span>`;
        submitBtn.setAttribute('disabled', 'true');

        setTimeout(() => {
          submitBtn.innerHTML = originalText;
          submitBtn.removeAttribute('disabled');
        }, 3000);
      }

      window.location.href = `mailto:zzawar521@gmail.com?subject=${subject}&body=${body}`;
    });
  }

  setupContactForm();
  document.addEventListener('astro:page-load', setupContactForm);
</script>

<style>
  #contact {
    padding-top: var(--section-py);
    padding-bottom: var(--section-py);
    position: relative;
  }

  .contact-wrapper {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-48);
  }

  @media (min-width: 900px) {
    .contact-wrapper {
      grid-template-columns: 1.1fr 1fr;
      align-items: start;
      gap: var(--space-64);
    }
  }

  /* Left Column */
  .contact-info-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .contact-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--font-size-small);
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }

  .contact-heading {
    margin: 0;
    font-size: clamp(28px, 4vw, 42px);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .contact-intro {
    color: var(--text-muted);
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    margin: 0;
    max-width: 54ch;
  }

  /* Availability status badge */
  .availability-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.25);
    color: #10B981;
    font-size: 13px;
    font-weight: 600;
    width: fit-content;
    margin: var(--space-8) 0;
  }

  .avail-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #10B981;
    box-shadow: 0 0 8px #10B981;
  }

  /* Direct Channels Grid */
  .channels-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    margin-top: var(--space-8);
  }

  @media (min-width: 540px) {
    .channels-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .channel-item {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    padding: var(--space-12) var(--space-16);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-tag);
    text-decoration: none;
    color: var(--text);
    transition: all 180ms ease;
    position: relative;
    overflow: hidden;
  }

  .channel-item:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.06);
    text-decoration: none;
  }

  :root[data-theme="dark"] .channel-item:hover {
    box-shadow: 0 6px 20px rgba(10, 132, 255, 0.15);
  }

  .channel-icon-wrap {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: var(--bg);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    flex-shrink: 0;
    transition: transform 180ms ease;
  }

  .channel-item:hover .channel-icon-wrap {
    transform: scale(1.08);
  }

  .channel-icon-wrap svg {
    width: 18px;
    height: 18px;
  }

  .icon-whatsapp {
    color: #10B981;
  }

  .icon-linkedin {
    color: #0A84FF;
  }

  .channel-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .channel-label {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--text-muted);
  }

  .channel-value {
    font-size: 13px;
    font-weight: 500;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .channel-action {
    color: var(--text-muted);
    opacity: 0.5;
    transition: all 180ms ease;
    flex-shrink: 0;
  }

  .channel-action svg {
    width: 16px;
    height: 16px;
  }

  .channel-item:hover .channel-action {
    opacity: 1;
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  /* Right Column: Form Card */
  .contact-form-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-media);
    padding: var(--space-32);
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.04);
  }

  :root[data-theme="dark"] .contact-form-card {
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.45);
  }

  .form-header {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .form-title {
    font-size: 20px;
    font-weight: 600;
    color: var(--text);
    margin: 0;
    line-height: 1.3;
  }

  .form-subtitle {
    font-size: var(--font-size-small);
    color: var(--text-muted);
    margin: 0;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .field-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .field-label {
    font-size: var(--font-size-small);
    font-weight: 600;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .req {
    color: #EF4444;
  }

  .input-wrap input,
  .input-wrap textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-tag);
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-family);
    font-size: var(--font-size-small);
    transition: border-color 180ms ease, box-shadow 180ms ease;
    box-sizing: border-box;
  }

  .input-wrap input::placeholder,
  .input-wrap textarea::placeholder {
    color: var(--text-muted);
    opacity: 0.6;
  }

  .input-wrap input:focus,
  .input-wrap textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(10, 132, 255, 0.15);
  }

  .input-wrap textarea {
    resize: vertical;
    min-height: 100px;
  }

  .submit-btn {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 48px;
    margin-top: var(--space-8);
  }

  .submit-btn svg {
    width: 16px;
    height: 16px;
    transition: transform 180ms ease;
  }

  .submit-btn:hover svg {
    transform: translate(2px, -2px);
  }

  .contact-form-note {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.4;
  }

  .contact-form-note svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .channel-item,
    .channel-icon-wrap,
    .channel-action,
    .submit-btn svg {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
