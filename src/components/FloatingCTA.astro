<style>
  /* Fixed dock — bottom-right corner, always on top */
  .floating-cta {
    position: fixed;
    bottom: 28px;
    right: 24px;
    z-index: 1000;

    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: center;
  }

  /* Individual button */
  .cta-btn {
    position: relative;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: #ffffff;

    /* Glassmorphism base */
    backdrop-filter: blur(12px) saturate(160%);
    -webkit-backdrop-filter: blur(12px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, 0.18);

    /* Float + lift on hover */
    transition:
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.2s ease;

    /* Staggered entrance animation */
    animation: cta-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  .cta-btn svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cta-btn:hover {
    transform: translateY(-5px) scale(1.12);
    opacity: 1 !important;
  }

  .cta-btn:hover svg {
    transform: scale(1.1);
  }

  /* Mute siblings slightly when one is hovered */
  .floating-cta:hover .cta-btn:not(:hover) {
    opacity: 0.6;
  }

  /* ── Brand colors ── */
  .cta-whatsapp {
    background: linear-gradient(135deg, #25d366 0%, #1da851 100%);
    box-shadow: 0 4px 18px -4px rgba(37, 211, 102, 0.5);
    animation-delay: 0.05s;
  }
  .cta-whatsapp:hover {
    box-shadow: 0 8px 28px -4px rgba(37, 211, 102, 0.7);
  }

  .cta-linkedin {
    background: linear-gradient(135deg, #0a66c2 0%, #004fa3 100%);
    box-shadow: 0 4px 18px -4px rgba(10, 102, 194, 0.5);
    animation-delay: 0.12s;
  }
  .cta-linkedin:hover {
    box-shadow: 0 8px 28px -4px rgba(10, 102, 194, 0.7);
  }

  .cta-github {
    background: linear-gradient(135deg, #333 0%, #24292e 100%);
    box-shadow: 0 4px 18px -4px rgba(0, 0, 0, 0.45);
    animation-delay: 0.19s;
  }
  .cta-github:hover {
    box-shadow: 0 8px 28px -4px rgba(0, 0, 0, 0.6);
  }

  /* Dark mode GitHub gets a subtle highlight */
  :root[data-theme="dark"] .cta-github {
    background: linear-gradient(135deg, #444 0%, #30363d 100%);
    box-shadow: 0 4px 18px -4px rgba(255, 255, 255, 0.12);
  }

  /* ── Tooltip label ── */
  .cta-tooltip {
    position: absolute;
    right: calc(100% + 10px);
    top: 50%;
    transform: translateY(-50%);
    white-space: nowrap;
    font-size: 12px;
    font-weight: 600;
    font-family: var(--font-family);
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 4px 10px;
    border-radius: var(--radius-tag);
    pointer-events: none;
    opacity: 0;
    translate: 6px 0;
    transition:
      opacity 0.2s ease,
      translate 0.2s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
  }

  .cta-btn:hover .cta-tooltip {
    opacity: 1;
    translate: 0 0;
  }

  /* ── Pop-in entrance ── */
  @keyframes cta-pop {
    from {
      opacity: 0;
      transform: scale(0.5) translateY(16px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .cta-btn {
      animation: none;
      transition: none;
    }
    .cta-btn:hover {
      transform: none;
    }
  }
</style>
